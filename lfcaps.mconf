
@ COMPILE prints bzero stpcpy 
	MLVALIST SHELLSORT strcmp strerror short_strerror  #verbose_errstr

#printv ltofmt 

#STRIPFLAG

SEGMENTS text
GLOBALS onstack
SHRINKELF

SOURCES lfcaps.c

DEPENDENCIES options.h tools.h lfcaps.h cap_table.h

BINARY lfcaps

export VERSION="0.3-beta."`revision.sh`
define VERSION $VERSION

define TOOL lfcaps
define LFCAPS_STANDALONE

on_success(){
	hash=$( cat lfcaps | skein256sum )
	sed -Ei "s/^(skein256:\s*).*/\1$hash/" README.md
	hash=$( cat lfcaps | sha3sum 32 )
	sed -Ei "s/^(sha3:\s*).*/\1$hash/" README.md
	sed -Ei "s/^(version\s*).*/\1$VERSION/" README.md
	echo $VERSION > version.txt
	cp lfcaps ./bin/
}







